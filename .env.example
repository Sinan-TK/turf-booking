# Copy to .env for local development (docker-compose defaults shown).

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://turf:turf@localhost:5432/turf_booking
REDIS_URL=redis://localhost:6379

# Admin/owner auth (self-hosted). Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=changeme_generate_a_32_byte_secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Invite / password-reset emails via Resend (blank = log links to console)
RESEND_API_KEY=
# Resend template for the emailed 6-digit codes (sign-up and forgot password). Template HTML: docs/email-templates/otp-code.html.
# Variables: HEADING, INTRO, CODE, NAME, EXPIRES_IN_MINUTES. Leave blank to send the built-in plain email.
RESEND_OTP_TEMPLATE_ID=
# Resend template ids for the owner emails (the templates live in Resend; variables in DEPLOYMENT.md). Empty = the built-in plain email is sent.
RESEND_OWNER_INVITE_TEMPLATE_ID=
RESEND_OWNER_RESET_TEMPLATE_ID=
RESEND_OWNER_APPROVED_TEMPLATE_ID=
EMAIL_OTP_TTL_MINUTES=10
MAIL_FROM=Bookyo <onboarding@resend.dev>

CUSTOMER_SESSION_SECRET=changeme_generate_a_32_byte_secret
CUSTOMER_SESSION_TTL_HOURS=168

# Google sign-in (customers only; the owner and admin portals use email and password). Create an OAuth "Web application" client in Google Cloud
# (APIs & Services > Credentials), add the app URLs as Authorized JavaScript origins, and use the same client ID
# here and in NEXT_PUBLIC_GOOGLE_CLIENT_ID for apps/web. Without it Google sign-in answers 503.
# GOOGLE_AUTH_MODE=fake accepts "test:<email>|<name>|<sub>" instead of a Google token (tests only; production refuses it).
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_MODE=google

# Customer login codes. "log" prints the code in the API log (development only);
# production must use "whatsapp" with an approved authentication template.
AUTH_OTP_DELIVERY=log
# WHATSAPP_OTP_TEMPLATE=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_CODES_PER_HOUR=5

# Opening hours / blackouts read path: rules (AvailabilityRule + BlockedPeriod) or legacy
# (OperatingHours + BlockedDate = rollback). Writes always go to both.
AVAILABILITY_SOURCE=rules

BOOKING_SESSION_TTL_MINUTES=20
SLOT_HOLD_TTL_MINUTES=10
PAYMENT_GRACE_WINDOW_MINUTES=10
PAYMENT_MAX_HOLD_MINUTES=20
PAYMENT_PROCESSING_MINUTES=5
WALLET_TOPUP_MIN=50
WALLET_TOPUP_MAX=10000

# Razorpay (leave blank in dev if not testing payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API (leave blank in dev if not testing WhatsApp)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Object storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public address of the bucket (an R2 custom domain or its r2.dev URL), no trailing slash. Unit photos are served
# from here. Without the five STORAGE_* values above plus this one, development saves photos to apps/api/.media and
# production refuses uploads.
STORAGE_PUBLIC_URL=
# This API's own public address (used for links to files it serves itself in development).
API_PUBLIC_URL=http://localhost:4000

WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
OWNER_APP_URL=http://localhost:3002

# Reverse-proxy hops in front of the API (unset = trust none). Verify per host; see DEPLOYMENT.md.
TRUST_PROXY=

# Docker compose, for the three web apps: the origin uploaded photos are served from (the host of STORAGE_PUBLIC_URL in apps/api/.env).
# Without it the browser's Content-Security-Policy blocks every unit and facility photo.
CSP_IMG_ORIGINS=https://your-bucket-public-host.example

# Customer site, build time: who the legal pages (terms, privacy, refunds) name. Leave unset to say "Bookyo" and point to the Support page.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_COMPANY_ADDRESS=
# The owner portal's address, for the landing page's "List your venue" button.
NEXT_PUBLIC_OWNER_URL=

# Owner portal, build time: the customer site (for the legal links on the sign-up page and the Venue Partner Terms).
NEXT_PUBLIC_CUSTOMER_URL=
