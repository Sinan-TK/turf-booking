# Copy to .env for local development (docker-compose defaults shown).

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://turf:turf@localhost:5432/turf_booking
REDIS_URL=redis://localhost:6379

# Admin/owner auth (self-hosted). Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=changeme_generate_a_32_byte_secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Invite / password-reset emails via Resend (blank = log links to console)
RESEND_API_KEY=
MAIL_FROM=Turf Booking <onboarding@resend.dev>

CUSTOMER_SESSION_SECRET=changeme_generate_a_32_byte_secret
CUSTOMER_SESSION_TTL_HOURS=168

# Customer login codes. "log" prints the code in the API log (development only);
# production must use "whatsapp" with an approved authentication template.
AUTH_OTP_DELIVERY=log
# WHATSAPP_OTP_TEMPLATE=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_CODES_PER_HOUR=5
DEFAULT_COUNTRY_CODE=91

# Opening hours / blackouts read path: rules (AvailabilityRule + BlockedPeriod) or legacy
# (OperatingHours + BlockedDate = rollback). Writes always go to both.
AVAILABILITY_SOURCE=rules

BOOKING_SESSION_TTL_MINUTES=20
SLOT_HOLD_TTL_MINUTES=10
PAYMENT_GRACE_WINDOW_MINUTES=10

# Razorpay (leave blank in dev if not testing payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API (leave blank in dev if not testing WhatsApp)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Object storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
OWNER_APP_URL=http://localhost:3002

# Reverse-proxy hops in front of the API (unset = trust none). Verify per host; see DEPLOYMENT.md.
TRUST_PROXY=
