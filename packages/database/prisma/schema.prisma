// Venue Booking Platform — Prisma schema
// See ARCHITECTURE.md for the full design rationale. Section references
// below (§N) point back to that document.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist, pg_trgm]
}

// =====================================================================
// Identity & Access (§5.2 "Identity & access", §12 RBAC)
// =====================================================================

enum AdminRole {
  SUPER_ADMIN
  // Reserved for future finer-grained staff roles (SUPPORT_AGENT,
  // FINANCE, ...) without a breaking change — see ARCHITECTURE.md §1.
}

model AdminUser {
  id     String    @id @default(uuid()) @db.Uuid
  /// scrypt hash (see @venue/database password.ts). Null until the invited
  /// admin accepts their invite link and sets a password — such a row
  /// cannot log in. This row is both profile and credential store; role
  /// claims in access tokens are derived from it at login/refresh.
  passwordHash String?
  email        String    @unique
  name         String
  role         AdminRole @default(SUPER_ADMIN)
  status       AdminUserStatus @default(ACTIVE)
  mfaSecret    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTickets  SupportTicket[]  @relation("AssignedAdmin")
  auditLogs        AuditLog[]       @relation("AdminAuditActor")
  coinAdjustments  CoinTransaction[] @relation("AdminCoinAdjustment")
  supportMessages  SupportMessage[]

  @@map("admin_users")
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

model OwnerOrganization {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactEmail String
  contactPhone String
  status       OwnerOrganizationStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerUsers  VenueOwnerUser[]
  venues       Venue[]
  commissions Commission[]
  promotions  Promotion[]

  @@map("owner_organizations")
}

enum OwnerOrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum OwnerUserRole {
  OWNER_ADMIN
  OWNER_STAFF
}

enum StaffPortal {
  ADMIN
  OWNER
}

enum StaffAuthTokenPurpose {
  INVITE
  PASSWORD_RESET
}

/// Single-use invite / password-reset links for admin and owner users.
/// Only the sha256 of the emailed token is stored. userId is polymorphic
/// (AdminUser.id or VenueOwnerUser.id, by portal), so there is no FK.
model StaffAuthToken {
  id        String                @id @default(uuid()) @db.Uuid
  portal    StaffPortal
  userId    String                @db.Uuid
  purpose   StaffAuthTokenPurpose
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([portal, userId])
  @@map("staff_auth_tokens")
}

/// Rotating refresh sessions for admin/owner logins (hashed token, one
/// row per issued refresh token). Revoking every row for a user is the
/// "logout everywhere" mechanism.
model StaffRefreshSession {
  id        String      @id @default(uuid()) @db.Uuid
  portal    StaffPortal
  userId    String      @db.Uuid
  tokenHash String      @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([portal, userId])
  @@map("staff_refresh_sessions")
}

model VenueOwnerUser {
  id             String        @id @default(uuid()) @db.Uuid
  /// See AdminUser.passwordHash — same design. organizationId and role
  /// are embedded in access tokens at login/refresh time.
  passwordHash   String?
  organizationId String        @db.Uuid
  organization   OwnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String        @unique
  name           String
  phone          String?
  role           OwnerUserRole @default(OWNER_STAFF)
  status         OwnerUserStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  createdBlockedDates BlockedDate[]
  // P1: BlockedPeriod mirrors BlockedDate (engine cutover in P3)
  createdBlockedPeriods BlockedPeriod[]
  createdPromotions   Promotion[]      @relation("OwnerPromotionCreator")
  auditLogs           AuditLog[]       @relation("OwnerAuditActor")
  notifications       OwnerNotification[]

  @@index([organizationId])
  @@map("venue_owner_users")
}

enum OwnerUserStatus {
  ACTIVE
  DISABLED
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

model CustomerProfile {
  id               String    @id @default(uuid()) @db.Uuid
  whatsappNumber   String    @unique
  name             String?
  email            String?   @unique
  profilePhotoUrl  String?
  defaultLat       Decimal?  @db.Decimal(9, 6)
  defaultLng       Decimal?  @db.Decimal(9, 6)
  defaultAreaId    String?   @db.Uuid
  defaultArea      Area?     @relation(fields: [defaultAreaId], references: [id])
  locale           String    @default("en-IN")
  status           CustomerStatus @default(ACTIVE)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  bookingSessions  BookingSession[]
  customerSessions CustomerSession[]
  savedVenues       SavedVenue[]
  slotHolds        SlotHold[]
  bookings         Booking[]
  supportTickets   SupportTicket[]
  coinWallet       CoinWallet?
  coinTransactions CoinTransaction[]
  notifications    Notification[]

  @@map("customer_profiles")
}

enum CustomerSessionSourceLinkType {
  BOOKING
  MY_BOOKINGS
  PROFILE
}

/// Auth mechanism for the customer web app — a server-side session, not a
/// JWT (confirmed decision, ARCHITECTURE.md §1 row 10, §12). The raw
/// session id lives only in an httpOnly cookie; this table stores its hash.
model CustomerSession {
  id                String    @id @default(uuid()) @db.Uuid
  customerId        String    @db.Uuid
  customer          CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionTokenHash  String    @unique
  sourceLinkType    CustomerSessionSourceLinkType
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?

  @@index([customerId])
  @@map("customer_sessions")
}

// =====================================================================
// Location & Facility Code generation (§5.2 "Location", §6.6)
//
// Country -> State -> District, each carrying its own real name plus a
// short `code` segment used to build human-readable Facility Codes
// (e.g. "KL" for Kerala, "MPM" for Malappuram -> "KLMPM10001"). These
// codes are internal platform codes, not official government codes.
//
// Country is a genuine ISO country (one row per real country — `isoCode`
// is globally unique). Kerala's launch format "KL" + district + sequence
// is generated from the STATE tier's code, not the country's: modeling
// it this way (rather than literally putting a "KL" Country row above
// India) avoids two different states one day needing the same
// isoCode-like top-level identifier, while producing byte-identical
// codes to what's specified. A country with no state/province tier can
// still generate codes once it has at least one State row (even a
// single catch-all one) — the Facility model itself never changes.
// =====================================================================

model Country {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  isoCode   String   @unique @db.Char(2) // ISO 3166-1 alpha-2, e.g. "IN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states State[]

  @@map("countries")
}

model State {
  id        String   @id @default(uuid()) @db.Uuid
  countryId String   @db.Uuid
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  name      String
  code      String   // platform code segment, e.g. "KL" for Kerala — not a government code
  status    LocationStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts District[]

  @@unique([countryId, code])
  @@unique([countryId, name])
  @@map("states")
}

model District {
  id        String   @id @default(uuid()) @db.Uuid
  stateId   String   @db.Uuid
  state     State    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  name      String
  code      String   // platform code segment, e.g. "MPM" for Malappuram — not a government code
  timezone  String
  status    LocationStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas            Area[]
  venues            Venue[]
  facilityCodeSeq  FacilityCodeSequence?

  @@unique([stateId, code])
  @@unique([stateId, name])
  @@map("districts")
}

/// Concurrency-safe per-district counter for Facility Code generation
/// (§6.6). A single `UPDATE ... SET "nextNumber" = "nextNumber" + 1
/// WHERE "districtId" = $1 RETURNING "nextNumber"` is used instead of a
/// read-then-write pair — Postgres's row-level lock on the UPDATE
/// serializes concurrent requests for the same district, so two
/// simultaneous facility creations in MPM can never receive the same
/// number (ARCHITECTURE.md's explicit "never KLMPM10001 twice"
/// requirement). Starts at 10000 so the first facility in a district is
/// numbered ...10001, matching the brief's example.
model FacilityCodeSequence {
  districtId String   @id @db.Uuid
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  nextNumber Int      @default(10000)
  updatedAt  DateTime @updatedAt

  @@map("facility_code_sequences")
}

model Area {
  id         String   @id @default(uuid()) @db.Uuid
  districtId String   @db.Uuid
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name       String
  status     LocationStatus @default(ACTIVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  venues     Venue[]
  customers CustomerProfile[]

  @@unique([districtId, name])
  @@map("areas")
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

// =====================================================================
// Venue / Resource (§5.2 "Venue / Resource", §6 conflict algorithm)
// =====================================================================

enum VenueStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// "Facility" in the product brief — the venue-level entity a customer
/// searches/saves by its public facilityCode. The internal `id` (UUID)
/// remains the primary key and foreign-key target everywhere;
/// facilityCode is a separate, immutable, publicly-shown identifier
/// (§6.6) — never used as a key.
model Venue {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @db.Uuid
  /// Venue type (VenueCategory). Drives labels, allowed resource unit
  /// types and the default BookingPolicy. Every existing venue was
  /// backfilled to FOOTBALL_TURF by migration venue_categories_link.
  categoryId                String   @db.Uuid
  category                  VenueCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  organization              OwnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Generated server-side on creation by the facility-code service
  /// (§6.6) — never client-supplied, never derived from `name`, never
  /// editable after creation (no update endpoint exposes this field).
  facilityCode              String   @unique
  name                      String
  description               String?
  districtId                String   @db.Uuid
  district                  District @relation(fields: [districtId], references: [id])
  areaId                    String?  @db.Uuid
  area                      Area?    @relation(fields: [areaId], references: [id])
  address                   String
  lat                       Decimal  @db.Decimal(9, 6)
  lng                       Decimal  @db.Decimal(9, 6)
  timezone                  String
  status                    VenueStatus @default(DRAFT)
  cancellationPolicyId      String?  @unique @db.Uuid
  cancellationPolicy        CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  defaultSlotGranularityMinutes Int  @default(60)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  deletedAt                 DateTime?

  operatingHours OperatingHours[]
  photos         VenuePhoto[]
  facilityTags   VenueFacilityTag[]
  blockedDates   BlockedDate[]
  resources      Resource[]
  bookings       Booking[]
  savedBy        SavedVenue[]
  supportTickets SupportTicket[]
  // P1 universal-venue skeleton (additive; engine cutover in P3/P4)
  resourceGroups    ResourceGroup[]
  bookingPolicies   BookingPolicy[]
  availabilityRules AvailabilityRule[]
  blockedPeriods    BlockedPeriod[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([districtId])
  @@index([lat, lng])
  @@map("venues")
}

/// Normalized (not JSON) so the availability engine can query with
/// indexes — see ARCHITECTURE.md §5.2.
model OperatingHours {
  id        String   @id @default(uuid()) @db.Uuid
  venueId    String   @db.Uuid
  venue      Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  weekday   Int      // 0 = Sunday .. 6 = Saturday
  openTime  String   // "HH:mm" local venue time
  closeTime String   // "HH:mm" local venue time

  @@unique([venueId, weekday])
  @@map("operating_hours")
}

model VenuePhoto {
  id        String   @id @default(uuid()) @db.Uuid
  venueId    String   @db.Uuid
  venue      Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([venueId])
  @@map("venue_photos")
}

model VenueFacilityTag {
  id     String @id @default(uuid()) @db.Uuid
  venueId String @db.Uuid
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tag    String // free-text tag ("PARKING", "FLOODLIGHTS", ...) — see §5.2

  @@unique([venueId, tag])
  @@map("venue_facility_tags")
}

model BlockedDate {
  id            String   @id @default(uuid()) @db.Uuid
  venueId        String   @db.Uuid
  venue          Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  resourceId    String?  @db.Uuid
  resource      Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startTime     DateTime @db.Timestamptz
  endTime       DateTime @db.Timestamptz
  reason        String?
  createdByOwnerUserId String? @db.Uuid
  createdByOwnerUser   VenueOwnerUser? @relation(fields: [createdByOwnerUserId], references: [id])
  createdAt     DateTime @default(now())

  @@index([venueId, startTime])
  @@index([resourceId, startTime])
  @@map("blocked_dates")
}

/// Bookable/organizational unit. Composition graph (below) — not a rigid
/// Venue -> Facility -> Resource ladder — models conflicts generically
/// (ARCHITECTURE.md §6.1).
model Resource {
  id          String   @id @default(uuid()) @db.Uuid
  venueId      String   @db.Uuid
  venue        Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  groundType  String   // open string ("5S", "7S", ...), not a hardcoded enum
  isBookable  Boolean  @default(true)
  status      ResourceStatus @default(ACTIVE)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pricingRules       PricingRule[]
  blockedDates       BlockedDate[]
  slotHolds          SlotHold[]
  resourceLocks      ResourceLock[]
  bookings           Booking[]
  // P1 universal-venue skeleton (additive; engine cutover in P3/P4)
  bookingPolicies   BookingPolicy[]
  availabilityRules AvailabilityRule[]
  blockedPeriods    BlockedPeriod[]

  // composition graph: this resource as a PARENT (composed of children)
  compositionsAsParent ResourceComposition[] @relation("CompositionParent")
  // composition graph: this resource as a CHILD (part of a parent)
  compositionsAsChild  ResourceComposition[] @relation("CompositionChild")

  // materialized transitive closure (ARCHITECTURE.md §6.1)
  closureAsAncestor   ResourceClosure[] @relation("ClosureAncestor")
  closureAsDescendant ResourceClosure[] @relation("ClosureDescendant")

  @@index([venueId])
  @@map("resources")
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
}

/// Direct edges: booking `childResource` conflicts with `parentResource`
/// and vice versa. E.g. parent = "7s Full", child = "5s Ground A".
model ResourceComposition {
  id               String   @id @default(uuid()) @db.Uuid
  parentResourceId String   @db.Uuid
  parentResource   Resource @relation("CompositionParent", fields: [parentResourceId], references: [id], onDelete: Cascade)
  childResourceId  String   @db.Uuid
  childResource    Resource @relation("CompositionChild", fields: [childResourceId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([parentResourceId, childResourceId])
  @@map("resource_compositions")
}

/// Materialized transitive closure of ResourceComposition, maintained by
/// the resources module on every composition write (§6.1). Gives O(1)
/// "what does booking resource X conflict with" lookups.
model ResourceClosure {
  id           String   @id @default(uuid()) @db.Uuid
  ancestorId   String   @db.Uuid
  ancestor     Resource @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendantId String   @db.Uuid
  descendant   Resource @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)
  depth        Int

  @@unique([ancestorId, descendantId])
  @@index([descendantId])
  @@map("resource_closures")
}

enum DayType {
  WEEKDAY
  WEEKEND
  HOLIDAY
}

/// Supports configurable durations per venue/resource and time-based
/// pricing (peak/off-peak) — ARCHITECTURE.md §5.2.
///
/// P2: a rule prices either one Resource (resourceId) or one pooled
/// ResourceGroup (resourceGroupId) — exactly one must be set (enforced
/// in the service layer, so legacy resource-only rows keep working
/// untouched). PER_UNIT multiplies price by the booked quantity (kayak
/// fleet); PER_BOOKING charges the flat price once.
enum PricingMode {
  PER_BOOKING
  PER_UNIT
}

model PricingRule {
  id              String   @id @default(uuid()) @db.Uuid
  resourceId      String?  @db.Uuid
  resource        Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceGroupId String?  @db.Uuid
  resourceGroup   ResourceGroup? @relation(fields: [resourceGroupId], references: [id], onDelete: Cascade)
  durationMinutes Int
  dayType         DayType
  startWindow     String?  // "HH:mm", optional peak/off-peak window
  endWindow       String?
  pricingMode     PricingMode @default(PER_BOOKING)
  price           Decimal  @db.Decimal(12, 2)
  currency        String   @default("INR") @db.Char(3)
  effectiveFrom   DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([resourceId, durationMinutes, dayType])
  @@index([resourceGroupId, durationMinutes, dayType])
  @@map("pricing_rules")
}

// =====================================================================
// Booking pipeline (§5.2, §6, §7, §8)
// =====================================================================

enum BookingSessionStatus {
  ACTIVE
  EXPIRED
  COMPLETED
  CANCELLED
}

enum BookingSessionSource {
  WHATSAPP
  WEB
}

/// The 20-minute browsing/booking JOURNEY placeholder — NOT a slot
/// reservation. See ARCHITECTURE.md's explicit distinction from SlotHold.
model BookingSession {
  id             String   @id @default(uuid()) @db.Uuid
  tokenHash      String   @unique
  customerId     String   @db.Uuid
  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status         BookingSessionStatus @default(ACTIVE)
  source         BookingSessionSource
  filters        Json?    // selected ground type/date/window/duration/location, for resuming
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())

  slotHolds SlotHold[]

  @@index([customerId, status])
  @@map("booking_sessions")
}

enum SlotHoldStatus {
  HELD
  CONFIRMED
  RELEASED
  EXPIRED
}

/// The actual reservation of inventory — separate 10-minute hold, distinct
/// from BookingSession (§8). Source of truth for availability.
///
/// P2: a hold targets exactly one inventory kind — one Resource
/// (resourceId, exclusive path, legacy behavior unchanged) or one pooled
/// ResourceGroup (resourceGroupId + quantity, kayak-fleet path). Enforced
/// in the service layer so existing rows (always resourceId, quantity 1)
/// need no migration beyond the column changes.
model SlotHold {
  id               String   @id @default(uuid()) @db.Uuid
  bookingSessionId String?  @db.Uuid
  bookingSession   BookingSession? @relation(fields: [bookingSessionId], references: [id], onDelete: SetNull)
  resourceId       String?  @db.Uuid
  resource         Resource? @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  resourceGroupId  String?  @db.Uuid
  resourceGroup    ResourceGroup? @relation(fields: [resourceGroupId], references: [id], onDelete: Restrict)
  quantity         Int      @default(1)
  customerId       String   @db.Uuid
  customer         CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startTime        DateTime @db.Timestamptz
  endTime          DateTime @db.Timestamptz
  status           SlotHoldStatus @default(HELD)
  holdExpiresAt    DateTime
  priceSnapshot    Json     // { amount, currency, breakdown } locked in at hold time
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  resourceLocks ResourceLock[]
  inventoryReservations InventoryReservation[]
  booking       Booking?

  @@index([resourceId, startTime])
  @@index([customerId, status])
  @@index([status, holdExpiresAt]) // expiry job scan
  @@map("slot_holds")
}

/// One row per resource in the closure(R) set for a hold (§6.3). Carries
/// the exclusion constraint (added via raw SQL migration — see
/// migrations/) that makes double-booking structurally impossible.
/// A `during` tstzrange generated column + GiST exclusion constraint is
/// added on top of startTime/endTime in the migration SQL, since Prisma's
/// schema DSL has no native EXCLUDE-constraint syntax.
///
/// !! `during` and `no_overlapping_resource_locks` are NOT declared here
/// !! because Prisma has no syntax for them — which means `prisma migrate
/// !! diff` / `migrate dev` will propose `DROP COLUMN "during"` on every
/// !! future schema change touching this table, since it looks unmanaged.
/// !! DO NOT apply that drop. Every migration generated against this
/// !! table must have that line stripped by hand before being applied
/// !! (see the add_token_version migration for the pattern) — it is the
/// !! entire anti-double-booking guarantee.
model ResourceLock {
  id         String   @id @default(uuid()) @db.Uuid
  slotHoldId String   @db.Uuid
  slotHold   SlotHold @relation(fields: [slotHoldId], references: [id], onDelete: Cascade)
  resourceId String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  startTime  DateTime @db.Timestamptz
  endTime    DateTime @db.Timestamptz
  status     SlotHoldStatus @default(HELD)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([resourceId, status])
  @@index([slotHoldId])
  @@map("resource_locks")
}

/// P2: the pooled-inventory counterpart to ResourceLock. One row per
/// SlotHold against a POOLED ResourceGroup, recording HOW MANY units the
/// hold takes out of the group's totalUnits for [startTime, endTime).
/// Concurrency safety comes from a different mechanism than the
/// exclusive path: the booking transaction locks the ResourceGroup row
/// (SELECT ... FOR UPDATE) and rejects when
/// SUM(overlapping HELD/CONFIRMED quantities) + requested > totalUnits.
/// A plain GiST index (NOT an exclusion constraint — exclusion is binary
/// occupancy and cannot express counting) backs the overlap lookup.
///
/// Like ResourceLock, the `during` tstzrange generated column below is
/// added via raw SQL migration — Prisma has no syntax for it — so future
/// `migrate diff` output touching this table must have any proposed
/// `DROP COLUMN "during"` stripped by hand before applying.
model InventoryReservation {
  id              String   @id @default(uuid()) @db.Uuid
  slotHoldId      String   @db.Uuid
  slotHold        SlotHold @relation(fields: [slotHoldId], references: [id], onDelete: Cascade)
  resourceGroupId String   @db.Uuid
  resourceGroup   ResourceGroup @relation(fields: [resourceGroupId], references: [id], onDelete: Restrict)
  quantity        Int
  startTime       DateTime @db.Timestamptz
  endTime         DateTime @db.Timestamptz
  status          SlotHoldStatus @default(HELD)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([resourceGroupId, status])
  @@index([slotHoldId])
  @@map("inventory_reservations")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingCancellationReasonCode {
  CUSTOMER_REQUESTED
  HOLD_EXPIRED
  RESOURCE_REALLOCATED
  ADMIN_ACTION
  OWNER_ACTION
}

enum PaymentMethod {
  MONEY
  COINS
  /// An owner-recorded walk-in/offline booking — no Payment row, no
  /// gateway involved; the Booking goes straight to CONFIRMED.
  OFFLINE
}

model Booking {
  id                       String   @id @default(uuid()) @db.Uuid
  // No @default(autoincrement()) here deliberately: the booking service
  // grabs nextval('booking_order_seq') itself *before* the insert (see
  // that migration's comment) so orderId can be computed and written in
  // the same INSERT, rather than inserting then updating.
  orderSeq                 BigInt   @unique
  orderId                  String   @unique // "BK" + zero-padded orderSeq, see @venue/shared formatOrderId
  slotHoldId               String   @unique @db.Uuid
  slotHold                 SlotHold @relation(fields: [slotHoldId], references: [id], onDelete: Restrict)
  customerId               String   @db.Uuid
  customer                 CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  venueId                   String   @db.Uuid
  venue                     Venue     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  // P2: exactly one of resourceId (exclusive) / resourceGroupId (pooled)
  // is set — same rule as SlotHold, enforced in the service layer.
  resourceId               String?  @db.Uuid
  resource                 Resource? @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  resourceGroupId          String?  @db.Uuid
  resourceGroup            ResourceGroup? @relation(fields: [resourceGroupId], references: [id], onDelete: Restrict)
  quantity                 Int      @default(1)
  startTime                DateTime @db.Timestamptz
  endTime                  DateTime @db.Timestamptz
  durationMinutes          Int
  groundType               String
  amount                   Decimal  @db.Decimal(12, 2)
  currency                 String   @default("INR") @db.Char(3)
  paymentMethod            PaymentMethod?
  status                   BookingStatus @default(PENDING_PAYMENT)
  cancellationReasonCode   BookingCancellationReasonCode?
  cancellationNote         String?
  cancelledAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  payments             Payment[]
  refunds              Refund[]
  coinTransactions     CoinTransaction[]
  supportTickets       SupportTicket[]
  promotionRedemption  PromotionRedemption?

  @@index([customerId, status])
  @@index([venueId, status])
  @@index([resourceId, startTime])
  @@map("bookings")
}

// =====================================================================
// Payments & Coins (§5.2, §9, §10)
// =====================================================================

enum PaymentProviderType {
  RAZORPAY
  COINS
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  bookingId        String   @db.Uuid
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  provider         PaymentProviderType
  gatewayOrderId   String?  @unique
  gatewayPaymentId String?  @unique
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @default("INR") @db.Char(3)
  status           PaymentStatus @default(PENDING)
  method           String?  // card/upi/netbanking/... from the gateway, informational
  failureReason    String?
  rawResponse      Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  refunds Refund[]

  @@index([bookingId])
  @@map("payments")
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Refunds are always credited as Coins, regardless of original
/// payment method — never returned to the original payment method
/// (ARCHITECTURE.md §11).
model Refund {
  id                   String   @id @default(uuid()) @db.Uuid
  bookingId            String   @db.Uuid
  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentId            String?  @db.Uuid
  payment              Payment? @relation(fields: [paymentId], references: [id])
  originalAmount       Decimal  @db.Decimal(12, 2)
  originalCurrency     String   @default("INR") @db.Char(3)
  coinAmountCredited   Decimal  @db.Decimal(12, 2)
  status               RefundStatus @default(PENDING)
  reason               String?
  policySnapshot       Json     // which policy/tier applied, for audit
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  coinTransactions CoinTransaction[]

  @@index([bookingId])
  @@map("refunds")
}

model CoinWallet {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @unique @db.Uuid
  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cachedBalance  Decimal  @default(0) @db.Decimal(12, 2)
  currency       String   @default("INR") @db.Char(3) // coins are pegged 1:1 to this currency (§1)
  updatedAt      DateTime @updatedAt

  transactions CoinTransaction[]

  @@map("coin_wallets")
}

enum CoinTransactionType {
  BOOKING_REWARD
  REFUND
  REFERRAL
  PROMOTION
  BOOKING_REDEMPTION
  ADMIN_ADJUSTMENT
}

/// Insert-only ledger — never updated (§10). `idempotencyKey` is a second,
/// independent safety net alongside WebhookEvent dedup and the
/// wallet-row lock (confirmed requirement, ARCHITECTURE.md §1 row 9).
model CoinTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  walletId        String   @db.Uuid
  wallet          CoinWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  customerId      String   @db.Uuid
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type            CoinTransactionType
  amount          Decimal  @db.Decimal(12, 2) // signed: +credit / -debit
  balanceAfter    Decimal  @db.Decimal(12, 2)
  bookingId       String?  @db.Uuid
  booking         Booking? @relation(fields: [bookingId], references: [id])
  refundId        String?  @db.Uuid
  refund          Refund?  @relation(fields: [refundId], references: [id])
  idempotencyKey  String   @unique
  createdByAdminId String? @db.Uuid
  createdByAdmin  AdminUser? @relation("AdminCoinAdjustment", fields: [createdByAdminId], references: [id])
  createdAt       DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([customerId, createdAt])
  @@map("coin_transactions")
}

// =====================================================================
// Policy & commercial (§5.2, §11)
// =====================================================================

enum CancellationPolicyScope {
  PLATFORM_DEFAULT
  VENUE
}

/// Tiers example: [{minHoursBeforeStart: 24, refundPercent: 100}, ...]
model CancellationPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  scope     CancellationPolicyScope
  tiers     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue?

  // P1: BookingPolicy references (never merges) CancellationPolicy (req 9)
  bookingPolicies BookingPolicy[]

  @@map("cancellation_policies")
}

enum CommissionScope {
  PLATFORM_DEFAULT
  ORGANIZATION
}

enum CommissionType {
  PERCENTAGE
  FLAT
}

/// Multiple rows per organization over time (effectiveFrom) — the owner
/// portal's "platform fee" figure always uses the latest row effective at
/// booking time, falling back to the PLATFORM_DEFAULT scope if the
/// organization has no override.
model Commission {
  id             String   @id @default(uuid()) @db.Uuid
  scope          CommissionScope
  organizationId String?  @db.Uuid
  organization   OwnerOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           CommissionType
  value          Decimal  @db.Decimal(12, 4)
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([organizationId, effectiveFrom])
  @@map("commissions")
}

enum PromotionScope {
  PLATFORM
  OWNER
}

enum PromotionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum PromotionDiscountType {
  PERCENTAGE
  FLAT
}

model Promotion {
  id                String   @id @default(uuid()) @db.Uuid
  scope             PromotionScope
  organizationId    String?  @db.Uuid
  organization      OwnerOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String?  @unique
  discountType      PromotionDiscountType
  discountValue     Decimal  @db.Decimal(12, 2)
  constraints       Json     // min amount, applicable ground types, date range, stackability
  approvalStatus    PromotionApprovalStatus @default(PENDING)
  createdByOwnerUserId String? @db.Uuid
  createdByOwnerUser   VenueOwnerUser? @relation("OwnerPromotionCreator", fields: [createdByOwnerUserId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  redemptions PromotionRedemption[]

  @@index([organizationId])
  @@map("promotions")
}

model PromotionRedemption {
  id              String   @id @default(uuid()) @db.Uuid
  promotionId     String   @db.Uuid
  promotion       Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  bookingId       String   @unique @db.Uuid
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId      String   @db.Uuid
  discountApplied Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@index([promotionId])
  @@map("promotion_redemptions")
}

// =====================================================================
// Support, saved venues, notifications, webhooks, audit (§5.2)
// =====================================================================

model SavedVenue {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  venueId     String   @db.Uuid
  venue       Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, venueId])
  @@map("saved_venues")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  REFUND_ISSUE
  PAID_BUT_BOOKING_FAILED
  BOOKING_ISSUE
  ACCOUNT_PROFILE_ISSUE
  OTHER
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId   String?  @db.Uuid
  booking     Booking? @relation(fields: [bookingId], references: [id])
  venueId      String?  @db.Uuid
  venue        Venue?    @relation(fields: [venueId], references: [id])
  category    SupportTicketCategory
  subject     String
  description String
  status      SupportTicketStatus @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  assignedToId String? @db.Uuid
  assignedTo  AdminUser? @relation("AssignedAdmin", fields: [assignedToId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages SupportMessage[]

  @@index([customerId, status])
  @@index([status, priority])
  @@map("support_tickets")
}

enum SupportMessageAuthorType {
  CUSTOMER
  ADMIN
  SYSTEM
}

model SupportMessage {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType  SupportMessageAuthorType
  authorAdminId String? @db.Uuid
  authorAdmin AdminUser? @relation(fields: [authorAdminId], references: [id])
  body        String
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String?  @db.Uuid
  customer      CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  templateKey   String
  payload       Json
  status        NotificationStatus @default(QUEUED)
  sentAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([customerId, status])
  @@map("notifications")
}

enum WebhookGateway {
  RAZORPAY
  WHATSAPP
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

/// Unique (gateway, eventId) is the idempotency mechanism for inbound
/// webhooks (§9 step 5, §17).
model WebhookEvent {
  id             String   @id @default(uuid()) @db.Uuid
  gateway        WebhookGateway
  eventId        String
  eventType      String
  payload        Json
  signatureValid Boolean
  status         WebhookEventStatus @default(RECEIVED)
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  @@unique([gateway, eventId])
  @@map("webhook_events")
}

enum AuditActorType {
  CUSTOMER
  OWNER
  ADMIN
  SYSTEM
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  actorType       AuditActorType
  actorAdminId    String?  @db.Uuid
  actorAdmin      AdminUser? @relation("AdminAuditActor", fields: [actorAdminId], references: [id])
  actorOwnerUserId String? @db.Uuid
  actorOwnerUser  VenueOwnerUser? @relation("OwnerAuditActor", fields: [actorOwnerUserId], references: [id])
  actorCustomerId String?  @db.Uuid
  action          String
  entityType      String
  entityId        String
  metadata        Json?
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorType, createdAt])
  @@map("audit_logs")
}

// =====================================================================
// Owner notification center (§ owner portal) — deliberately NOT named
// `Notification`: that model above is for outbound customer delivery
// tracking (WhatsApp/Email/IN_APP channel + QUEUED/SENT/FAILED status),
// a different shape and purpose entirely. This is a persistent, in-app
// read/unread feed for Venue Owner logins, written by backend business
// events (booking/payment lifecycle) and Super Admin announcements —
// never created from the frontend.
// =====================================================================

enum OwnerNotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  // No reschedule feature exists anywhere in this codebase today — this
  // value exists for forward-compatibility only and is never triggered.
  BOOKING_RESCHEDULED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  ADMIN_ANNOUNCEMENT
  ADMIN_WARNING
  SYSTEM
}

model OwnerNotification {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  owner     VenueOwnerUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type      OwnerNotificationType
  title     String
  message   String
  /// Navigation metadata only (bookingId/orderId/venueId/resourceId for
  /// booking-related notifications) — never a substitute for title/message.
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([ownerId, readAt])
  @@map("owner_notifications")
}

// =====================================================================
// P1: Universal hourly-venue domain skeleton (additive only)
// ---------------------------------------------------------------------
// New tables + enums only. No existing table, column, index, FK,
// sequence, or raw-SQL object is altered here. The booking,
// availability, payment, and coin engines keep reading the legacy
// tables (OperatingHours, BlockedDate, hardcoded duration rules) until
// the P3 cutover. Physical renames (Venue->Venue, Coins->Credits) land
// in P4. New tables reference the EXISTING Venue/Resource/
// CancellationPolicy/VenueOwnerUser models; the Venue->Venue rename in
// P4 will re-point these FKs.
// =====================================================================

/// Allocation strategy for a category or resource group. EXCLUSIVE =
/// one booking holds the unit (all current venues + whole-pool hire).
/// POOLED = interchangeable quantity inventory (kayak fleets, P2).
/// Categories themselves are database ROWS (VenueCategory.slug), never
/// enum values — future categories need no schema change (req 1, 7).
enum AllocationMode {
  EXCLUSIVE
  POOLED
}

/// BookingPolicy scope chain (most-specific wins at resolution time in
/// P3): RESOURCE > GROUP > VENUE > CATEGORY > PLATFORM_DEFAULT. Kept
/// deliberately separate from CancellationPolicyScope / the
/// CancellationPolicy table (req 9) — a policy only REFERENCES a
/// cancellation policy for refund tiers.
enum BookingPolicyScope {
  PLATFORM_DEFAULT
  CATEGORY
  VENUE
  GROUP
  RESOURCE
}

/// Database-driven venue taxonomy. One row per entertainment category;
/// adding "pickleball" or "padel" later is an INSERT, not a migration.
model VenueCategory {
  id                    String         @id @default(uuid()) @db.Uuid
  slug                  String         @unique
  name                  String
  defaultAllocationMode AllocationMode
  attributesSchema      Json?
  isActive              Boolean        @default(true)
  /// UI icon key (mapped client-side), e.g. "sports_soccer".
  iconKey               String         @default("category")
  /// What one bookable unit is called: "Table", "Court", "Pitch"...
  unitLabel             String         @default("Unit")
  /// What a venue of this type is called: "Chess club", "Venue"...
  venueLabel            String         @default("Venue")
  /// Allowed Resource.groundType values. Empty = free text.
  unitTypes             String[]       @default([])
  sortOrder             Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  bookingPolicies BookingPolicy[]
  venues           Venue[]

  @@map("venue_categories")
}

/// Named inventory pool inside a Venue. P2 uses POOLED groups for kayak
/// SINGLE/DOUBLE fleets (totalUnits = boat count); EXCLUSIVE venues may
/// use groups organisationally (e.g. "Hall A courts") without changing
/// the composition-graph conflict engine.
model ResourceGroup {
  id             String         @id @default(uuid()) @db.Uuid
  venueId         String         @db.Uuid
  venue           Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name           String
  allocationMode AllocationMode
  totalUnits     Int?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  bookingPolicies   BookingPolicy[]
  availabilityRules AvailabilityRule[]
  blockedPeriods    BlockedPeriod[]
  // P2: pooled inventory pools (e.g. kayak fleets) + their pricing
  inventoryReservations InventoryReservation[]
  pricingRules          PricingRule[]
  slotHolds             SlotHold[]
  bookings              Booking[]

  @@index([venueId])
  @@map("resource_groups")
}

/// Configurable booking rules (interval, min/max/increment durations,
/// buffers, advance window). Replaces the hardcoded whole-hour / 60-180
/// rules at the P3 engine cutover. Scope chain: RESOURCE > GROUP >
/// VENUE > CATEGORY > PLATFORM_DEFAULT.
model BookingPolicy {
  id                   String             @id @default(uuid()) @db.Uuid
  scope                BookingPolicyScope
  categoryId           String?            @db.Uuid
  category             VenueCategory?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  venueId               String?            @db.Uuid
  venue                 Venue?              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  resourceGroupId      String?            @db.Uuid
  resourceGroup        ResourceGroup?     @relation(fields: [resourceGroupId], references: [id], onDelete: Cascade)
  resourceId           String?            @db.Uuid
  resource             Resource?          @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  slotIntervalMin      Int
  minDurationMin       Int
  maxDurationMin       Int
  durationIncrementMin Int
  bufferBeforeMin      Int                @default(0)
  bufferAfterMin       Int                @default(0)
  maxAdvanceDays       Int
  minLeadMinutes       Int
  cancellationPolicyId String?            @db.Uuid
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  effectiveFrom        DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([scope, effectiveFrom])
  @@map("booking_policies")
}

/// Multi-window successor to OperatingHours (which allows exactly one
/// window per weekday). P1 backfills a 1:1 copy for cutover
/// verification; the availability engine keeps reading OperatingHours
/// until P3. `sourceOperatingHoursId` makes the backfill idempotent.
model AvailabilityRule {
  id                     String         @id @default(uuid()) @db.Uuid
  venueId                 String         @db.Uuid
  venue                   Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  resourceId             String?        @db.Uuid
  resource               Resource?      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceGroupId        String?        @db.Uuid
  resourceGroup          ResourceGroup? @relation(fields: [resourceGroupId], references: [id], onDelete: Cascade)
  weekday                Int
  openTime               String
  closeTime              String
  validFrom              DateTime?
  validTo                DateTime?
  sourceOperatingHoursId String?        @unique @db.Uuid
  createdAt              DateTime       @default(now())

  @@index([venueId, weekday])
  @@index([resourceId, weekday])
  @@map("availability_rules")
}

/// Group-aware successor to BlockedDate. P1 backfills a verbatim copy
/// (Timestamptz values copied with NO conversion — timezone semantics
/// preserved); BlockedDate stays authoritative until P3.
/// `sourceBlockedDateId` makes the backfill idempotent.
model BlockedPeriod {
  id                  String         @id @default(uuid()) @db.Uuid
  venueId              String         @db.Uuid
  venue                Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  resourceId          String?        @db.Uuid
  resource            Resource?      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceGroupId     String?        @db.Uuid
  resourceGroup       ResourceGroup? @relation(fields: [resourceGroupId], references: [id], onDelete: Cascade)
  startTime           DateTime       @db.Timestamptz
  endTime             DateTime       @db.Timestamptz
  reason              String?
  createdByOwnerUserId String?       @db.Uuid
  createdByOwnerUser  VenueOwnerUser? @relation(fields: [createdByOwnerUserId], references: [id])
  sourceBlockedDateId String?        @unique @db.Uuid
  createdAt           DateTime       @default(now())

  @@index([venueId, startTime])
  @@index([resourceId, startTime])
  @@map("blocked_periods")
}
